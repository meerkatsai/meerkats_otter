{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meerkats.ai/schemas/diagnose_and_recommend/v1.json",
  "title": "Meerkats Diagnose & Recommend v1 — diagnosis, simulation, recommendation",
  "description": "The agentic, read-only cognition family, deliberately separate from the deterministic query_and_act layer. Three task types, one honesty machinery: every result passes a data-quality gate before asserting anything, and every number traces to a re-runnable, catalog-grounded evidence query. diagnosis explains a movement as a ranked cause tree; simulation projects forward (change absent = baseline forecast, present = counterfactual) with mandatory uncertainty intervals and sourced assumptions; recommendation emits ranked proposals into the approval queue — bindable ones carry the binder's proof against the capability registry (fail closed, same rule as workflows), advisory ones say why they aren't executable. Nothing in this family executes: a bindable proposal becomes a query_and_act execution_plan only after human approval freezes its selection. Cross-file $refs point at https://meerkats.ai/schemas/query_and_act/v1.json — both schemas must be registered in the validator. Root validates any of the three RESULT artifacts; requests are validated by their named $defs.",
  "oneOf": [
    {
      "$ref": "#/$defs/diagnosis_result"
    },
    {
      "$ref": "#/$defs/simulation_result"
    },
    {
      "$ref": "#/$defs/recommendation_result"
    }
  ],
  "$defs": {
    "diagnosis_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "task_type",
        "task"
      ],
      "description": "LLM/planner-emitted. Names the movement to explain; does not prescribe how.",
      "properties": {
        "version": {
          "const": "1.0"
        },
        "task_type": {
          "const": "diagnosis"
        },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entity",
            "metric",
            "comparison"
          ],
          "properties": {
            "entity": {
              "type": "string"
            },
            "metric": {
              "type": "string",
              "description": "the metric whose movement is under investigation"
            },
            "time_range": {
              "$ref": "https://meerkats.ai/schemas/query_and_act/v1.json#/$defs/time_range"
            },
            "comparison": {
              "$ref": "https://meerkats.ai/schemas/query_and_act/v1.json#/$defs/comparison",
              "description": "defines the movement (current vs baseline) being explained"
            },
            "objective": {
              "type": "string",
              "enum": [
                "explain_change"
              ],
              "default": "explain_change"
            },
            "decompose_by": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "optional prioritization hint (dimensions or factors); the agent may investigate beyond it"
            }
          }
        }
      }
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delta_abs",
        "delta_share"
      ],
      "description": "How much of a movement a node accounts for. Signed throughout: negative delta_abs pushed the metric down.",
      "properties": {
        "delta_abs": {
          "type": "number",
          "description": "signed change in metric units attributed to this node"
        },
        "delta_share": {
          "type": "number",
          "description": "delta_abs as a fraction of the root observation's total delta. Root = 1.0. May exceed 1 or flip sign when other movers offset."
        },
        "baseline_value": {
          "type": "number"
        },
        "current_value": {
          "type": "number"
        }
      }
    },
    "root_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "comparison",
        "direction",
        "contribution"
      ],
      "description": "The confirmed movement being explained — the tree's root.",
      "properties": {
        "metric": {
          "type": "string"
        },
        "time_range": {
          "$ref": "https://meerkats.ai/schemas/query_and_act/v1.json#/$defs/time_range"
        },
        "comparison": {
          "$ref": "https://meerkats.ai/schemas/query_and_act/v1.json#/$defs/comparison"
        },
        "direction": {
          "type": "string",
          "enum": [
            "increase",
            "decrease"
          ]
        },
        "contribution": {
          "$ref": "#/$defs/contribution",
          "description": "at the root, delta_share is 1.0 by definition"
        }
      }
    },
    "decomposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "additive"
      ],
      "description": "Declares how a node's children were derived AND how they relate to it arithmetically. Absent on leaf nodes.",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "dimensional",
            "factor",
            "none"
          ],
          "description": "dimensional: split by a dimension (platform, geo, sku). factor: split into driver terms (revenue = orders x aov). none: children are independent hypotheses."
        },
        "by": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "dimensional: the dimension(s) split on. factor: the driver terms."
        },
        "additive": {
          "type": "boolean",
          "description": "true: children delta_abs sum to this node's delta_abs (dimensional). false: multiplicative drivers, attributed additively via log/LMDI decomposition (factor)."
        },
        "residual": {
          "type": "number",
          "description": "portion of this node's delta_abs not attributed to any child — interaction/mix effect or unexplained"
        }
      }
    },
    "cause_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cause_id",
        "statement",
        "kind",
        "contribution",
        "confidence",
        "status"
      ],
      "description": "One candidate cause. Recurses via children into sub-causes.",
      "properties": {
        "cause_id": {
          "type": "string"
        },
        "statement": {
          "type": "string",
          "description": "human-readable claim, e.g. 'Meta revenue fell 32%, driven by CVR'"
        },
        "kind": {
          "type": "string",
          "enum": [
            "localization",
            "factor",
            "data_artifact",
            "external",
            "hypothesis"
          ],
          "description": "localization: a slice owns the drop. factor: a driver term moved. data_artifact: a pipeline/tag issue. external: seasonality/stockout/event. hypothesis: proposed, not yet evidenced."
        },
        "contribution": {
          "$ref": "#/$defs/contribution"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "strength of evidential support; orthogonal to contribution — a big mover can be low-confidence"
        },
        "status": {
          "type": "string",
          "enum": [
            "supported",
            "ruled_out",
            "unverified"
          ],
          "description": "ruled_out nodes are kept on purpose — 'checked, not a data lag' is a result worth showing"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "evidence_ids in diagnosis_result.evidence that support this node"
        },
        "decomposition": {
          "$ref": "#/$defs/decomposition"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cause_node"
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary"
      ],
      "description": "The salient result extracted from an evidence query — not the full row set.",
      "properties": {
        "summary": {
          "type": "string"
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "named scalars pulled from the query result, e.g. { delta: -12400, share: 0.32 }"
        }
      }
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "query",
        "finding"
      ],
      "description": "A validated, catalog-grounded query and what it showed. Re-runnable for audit — this is what keeps the agentic layer honest.",
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "query": {
          "$ref": "https://meerkats.ai/schemas/query_and_act/v1.json#/$defs/query_task",
          "description": "the exact query_task the agent ran to produce this evidence"
        },
        "finding": {
          "$ref": "#/$defs/finding"
        },
        "data_as_of": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checks"
      ],
      "description": "Precondition gate, evaluated before causes are asserted. A pipeline lag or broken tag mimics a real drop; if this comes back suspect the movement itself is in doubt and the cause tree is withheld.",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "clean",
            "suspect",
            "unchecked"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "result"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "e.g. freshness_lag, tag_coverage, spend_reconciliation"
              },
              "result": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "warn"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "diagnosis_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnosis_id",
        "generated_at",
        "observation",
        "status",
        "data_quality",
        "evidence"
      ],
      "properties": {
        "diagnosis_id": {
          "type": "string",
          "format": "uuid"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "observation": {
          "$ref": "#/$defs/root_observation"
        },
        "status": {
          "type": "string",
          "enum": [
            "explained",
            "partially_explained",
            "inconclusive",
            "data_quality_blocked"
          ]
        },
        "data_quality": {
          "$ref": "#/$defs/data_quality"
        },
        "root_cause_tree": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cause_node"
          },
          "description": "top-level candidate causes; each may nest. Empty when data_quality_blocked."
        },
        "primary_causes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "cause_ids ordered by |delta_share| among supported causes — the ranked headline answer, pre-computed so consumers don't re-rank the tree"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_item"
          },
          "description": "flat store; cause nodes and data-quality checks reference into it by evidence_id"
        },
        "unexplained_share": {
          "type": "number",
          "description": "fraction of the root delta not attributed to any supported cause; 1 - sum of supported top-level shares (net of offsets)"
        }
      },
      "allOf": [
        {
          "description": "A data-quality-blocked diagnosis must not also assert causes.",
          "if": {
            "properties": {
              "status": {
                "const": "data_quality_blocked"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "root_cause_tree": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "periods",
        "grain"
      ],
      "description": "How far forward the simulation projects.",
      "properties": {
        "periods": {
          "type": "integer",
          "minimum": 1
        },
        "grain": {
          "type": "string",
          "enum": [
            "day",
            "week",
            "month"
          ]
        }
      }
    },
    "simulation_change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection",
        "operation"
      ],
      "description": "The hypothetical intervention. Reuses query_and_act shapes verbatim so a simulated change is EXPRESSED IN exactly the vocabulary an action would use — if it can't be written as an operation, it can't be simulated as one.",
      "properties": {
        "selection": {
          "$ref": "https://meerkats.ai/schemas/query_and_act/v1.json#/$defs/selection_request",
          "description": "which entities the hypothetical change applies to"
        },
        "operation": {
          "$ref": "https://meerkats.ai/schemas/query_and_act/v1.json#/$defs/operation"
        },
        "applies_from": {
          "type": "string",
          "format": "date",
          "description": "start of the intervention inside the horizon; default = horizon start"
        }
      }
    },
    "simulation_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "task_type",
        "task"
      ],
      "description": "LLM/planner-emitted. ONE task type, TWO modes, switched structurally: task.change absent = baseline forecast; task.change present = counterfactual.",
      "properties": {
        "version": {
          "const": "1.0"
        },
        "task_type": {
          "const": "simulation"
        },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entity",
            "metric",
            "horizon"
          ],
          "properties": {
            "entity": {
              "type": "string"
            },
            "metric": {
              "type": "string",
              "description": "catalog concept name — resolved per platform/grain by the catalog, never a raw column"
            },
            "horizon": {
              "$ref": "#/$defs/horizon"
            },
            "history_window": {
              "$ref": "https://meerkats.ai/schemas/query_and_act/v1.json#/$defs/time_range",
              "description": "the history the model may fit on; validated queries only"
            },
            "change": {
              "$ref": "#/$defs/simulation_change"
            }
          }
        }
      }
    },
    "forecast_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "value",
        "interval"
      ],
      "description": "One projected period. The interval is REQUIRED — a projection without stated uncertainty is an opinion dressed as a number.",
      "properties": {
        "period": {
          "type": "string",
          "description": "ISO date / ISO week / YYYY-MM at the horizon grain"
        },
        "value": {
          "type": "number"
        },
        "interval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lo",
            "hi",
            "level"
          ],
          "properties": {
            "lo": {
              "type": "number"
            },
            "hi": {
              "type": "number"
            },
            "level": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1,
              "description": "e.g. 0.8 for an 80% interval"
            }
          }
        }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assumption_id",
        "statement",
        "source"
      ],
      "description": "Every lever→response belief the projection rests on, with provenance. platform_heuristic sources cite the diagnostics/capabilities pack entry.",
      "properties": {
        "assumption_id": {
          "type": "string"
        },
        "statement": {
          "type": "string",
          "description": "e.g. 'budget +20% yields clicks +12–16%: response is concave near DAILY_BUDGET_MET'"
        },
        "source": {
          "type": "string",
          "enum": [
            "platform_heuristic",
            "catalog_caveat",
            "observed_history",
            "user_provided"
          ]
        },
        "ref": {
          "type": "string",
          "description": "pointer into the source: heuristics key, catalog caveat id, or evidence_id"
        }
      }
    },
    "simulation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "simulation_id",
        "generated_at",
        "entity",
        "metric",
        "mode",
        "method",
        "assumptions",
        "data_quality",
        "status",
        "baseline",
        "evidence"
      ],
      "description": "What the simulator emits back. Same honesty machinery as diagnosis: a data-quality gate before any number is asserted, and every fitted input is a re-runnable evidence query.",
      "properties": {
        "simulation_id": {
          "type": "string",
          "format": "uuid"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "entity": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "baseline_forecast",
            "counterfactual"
          ]
        },
        "change": {
          "$ref": "#/$defs/simulation_change",
          "description": "echo of the request's change; present iff mode=counterfactual"
        },
        "horizon": {
          "$ref": "#/$defs/horizon"
        },
        "method": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "description"
          ],
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "seasonal_naive",
                "moving_average",
                "exponential_smoothing",
                "regression",
                "response_curve",
                "causal_impact",
                "judgmental"
              ]
            },
            "description": {
              "type": "string",
              "description": "how it was fit, in one sentence a reviewer can challenge"
            }
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assumption"
          }
        },
        "data_quality": {
          "$ref": "#/$defs/data_quality"
        },
        "status": {
          "type": "string",
          "enum": [
            "projected",
            "low_confidence",
            "insufficient_history",
            "data_quality_blocked"
          ]
        },
        "baseline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/forecast_point"
          },
          "description": "the no-change path. Empty when insufficient_history or data_quality_blocked."
        },
        "counterfactual": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/forecast_point"
          },
          "description": "the with-change path; same periods as baseline"
        },
        "delta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total_abs"
          ],
          "description": "counterfactual minus baseline over the horizon",
          "properties": {
            "total_abs": {
              "type": "number"
            },
            "total_pct": {
              "type": "number"
            }
          }
        },
        "unmodeled": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "factors known to matter but not in the model (festival spikes, stockouts, competitor moves) — named, not silently ignored"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_item"
          },
          "description": "the historical queries the fit consumed"
        }
      },
      "allOf": [
        {
          "description": "counterfactual mode must carry the change and both paths",
          "if": {
            "properties": {
              "mode": {
                "const": "counterfactual"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "change",
              "counterfactual",
              "delta"
            ]
          }
        },
        {
          "description": "baseline mode must not smuggle in counterfactual artifacts",
          "if": {
            "properties": {
              "mode": {
                "const": "baseline_forecast"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "change"
                  ]
                },
                {
                  "required": [
                    "counterfactual"
                  ]
                },
                {
                  "required": [
                    "delta"
                  ]
                }
              ]
            }
          }
        },
        {
          "description": "a blocked or history-starved simulation asserts no numbers",
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "insufficient_history",
                  "data_quality_blocked"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "baseline": {
                "maxItems": 0
              },
              "counterfactual": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "goal"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "description": "catalog concept name"
        },
        "goal": {
          "type": "string",
          "enum": [
            "increase",
            "decrease",
            "hit_target"
          ]
        },
        "target_value": {
          "type": "number"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "goal": {
                "const": "hit_target"
              }
            },
            "required": [
              "goal"
            ]
          },
          "then": {
            "required": [
              "target_value"
            ]
          }
        }
      ]
    },
    "constraint": {
      "type": "object",
      "description": "A hard boundary proposals must respect. Typed, so the checker is code.",
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "budget_cap"
            },
            "amount": {
              "$ref": "https://meerkats.ai/schemas/query_and_act/v1.json#/$defs/amount_absolute",
              "description": "max total budget change across all proposals"
            }
          },
          "required": [
            "type",
            "amount"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "efficiency_floor"
            },
            "metric": {
              "type": "string"
            },
            "min_value": {
              "type": "number"
            }
          },
          "required": [
            "type",
            "metric",
            "min_value"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "exclude"
            },
            "selection": {
              "$ref": "https://meerkats.ai/schemas/query_and_act/v1.json#/$defs/selection_request",
              "description": "entities proposals may not touch"
            }
          },
          "required": [
            "type",
            "selection"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "custom"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "note"
          ],
          "additionalProperties": false
        }
      ]
    },
    "recommendation_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "task_type",
        "task"
      ],
      "description": "LLM/planner-emitted. Read-only: the answer is a ranked set of PROPOSALS, never an execution.",
      "properties": {
        "version": {
          "const": "1.0"
        },
        "task_type": {
          "const": "recommendation"
        },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "objective"
          ],
          "properties": {
            "objective": {
              "$ref": "#/$defs/objective"
            },
            "scope": {
              "$ref": "https://meerkats.ai/schemas/query_and_act/v1.json#/$defs/selection_request",
              "description": "where to look for moves; absent = whole account"
            },
            "constraints": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/constraint"
              }
            },
            "horizon": {
              "$ref": "#/$defs/horizon"
            }
          }
        }
      }
    },
    "projected_impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric"
      ],
      "description": "What the proposal is expected to do to the objective metric, and where that number came from. At least one of delta_abs / delta_pct.",
      "properties": {
        "metric": {
          "type": "string"
        },
        "delta_abs": {
          "type": "number"
        },
        "delta_pct": {
          "type": "number"
        },
        "simulation_ref": {
          "type": "string",
          "format": "uuid",
          "description": "simulation_id of the counterfactual that produced this number"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "delta_abs"
          ]
        },
        {
          "required": [
            "delta_pct"
          ]
        }
      ]
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "rank",
        "statement",
        "kind",
        "projected_impact",
        "risk"
      ],
      "description": "One recommended move. kind=bindable_action means the binder ALREADY confirmed (platform, entity, operation) resolves through the capability registry — same fail-closed rule as workflows, applied at proposal time so the approval queue never shows a button that can't be pressed. kind=advisory is everything real but unbindable (creative refresh, Flipkart ads changes) — stated as advice with the reason, never dressed as an executable. On approval, a bindable proposal's selection is frozen by the resolver and becomes a query_and_act execution_plan; this artifact itself executes nothing.",
      "properties": {
        "proposal_id": {
          "type": "string",
          "format": "uuid",
          "description": "what the approval queue references"
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "statement": {
          "type": "string",
          "description": "human-readable, e.g. 'Shift ₹40k/mo from Generic Terms to Competitor Conquest'"
        },
        "kind": {
          "type": "string",
          "enum": [
            "bindable_action",
            "advisory"
          ]
        },
        "selection": {
          "$ref": "https://meerkats.ai/schemas/query_and_act/v1.json#/$defs/selection_request",
          "description": "which entities the proposal touches (resolver freezes it at approval time)"
        },
        "operation": {
          "$ref": "https://meerkats.ai/schemas/query_and_act/v1.json#/$defs/operation"
        },
        "binding_check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "registry_version",
            "operation_key",
            "bindable"
          ],
          "description": "BINDER-PRODUCED. bindable is const true: an unbindable operation makes the proposal advisory (or drops it), never a bindable_action with false.",
          "properties": {
            "registry_version": {
              "type": "integer",
              "minimum": 1
            },
            "operation_key": {
              "type": "string",
              "description": "e.g. amazon campaign.set_budget"
            },
            "bindable": {
              "const": true
            }
          }
        },
        "advisory_reason": {
          "type": "string",
          "description": "why this cannot be a bindable action, e.g. 'Flipkart ads have no public API — alert-only platform'"
        },
        "projected_impact": {
          "$ref": "#/$defs/projected_impact"
        },
        "risk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "risk_level",
            "reversible"
          ],
          "description": "proposal-time estimate; the authoritative risk is recomputed by the server on the execution_plan after the selection is resolved",
          "properties": {
            "risk_level": {
              "type": "string",
              "enum": [
                "read_only",
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            "reversible": {
              "type": "boolean"
            }
          }
        },
        "tradeoffs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "what this move costs, stated — e.g. 'reach shrinks while efficiency improves'"
        }
      },
      "allOf": [
        {
          "description": "a bindable proposal must carry the operation, its selection, and the binder's proof",
          "if": {
            "properties": {
              "kind": {
                "const": "bindable_action"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "selection",
              "operation",
              "binding_check"
            ]
          }
        },
        {
          "description": "an advisory proposal states why, and cannot carry an operation or binding",
          "if": {
            "properties": {
              "kind": {
                "const": "advisory"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "advisory_reason"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "operation"
                  ]
                },
                {
                  "required": [
                    "binding_check"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "recommendation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommendation_id",
        "generated_at",
        "objective",
        "status",
        "data_quality",
        "proposals",
        "evidence"
      ],
      "description": "Ranked proposals into the approval queue. no_viable_action is a legitimate answer — 'nothing satisfies the constraints' beats a proposal that violates them.",
      "properties": {
        "recommendation_id": {
          "type": "string",
          "format": "uuid"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "objective": {
          "$ref": "#/$defs/objective"
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint"
          },
          "description": "echo of the constraints every proposal was checked against"
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "no_viable_action",
            "data_quality_blocked"
          ]
        },
        "data_quality": {
          "$ref": "#/$defs/data_quality"
        },
        "proposals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proposal"
          },
          "description": "ordered by rank. Empty when no_viable_action or data_quality_blocked."
        },
        "diagnosis_ref": {
          "type": "string",
          "format": "uuid",
          "description": "diagnosis_id this recommendation acts on, when it follows a diagnosis"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_item"
          }
        }
      },
      "allOf": [
        {
          "description": "a result that proposes nothing must say so in status, and vice versa",
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "no_viable_action",
                  "data_quality_blocked"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "proposals": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "proposed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "proposals": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
